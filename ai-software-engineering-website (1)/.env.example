# Local env template — copy to `.env.local` for development.
# On Vercel these are set in Project Settings → Environment Variables instead.
#
# Only the two PUBLIC variables below belong in the frontend. The Supabase
# `service_role` secret key must never be placed here or in any VITE_ var.

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable (anon) API key (Project Settings → API → Project API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
