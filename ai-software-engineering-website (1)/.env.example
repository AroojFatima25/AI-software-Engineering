# Supabase — client-side configuration
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# On Vercel, set the same two names under
# Project → Settings → Environment Variables (Production + Preview).
# Vite inlines `VITE_*` values into the bundle at build time, so a change here
# requires a redeploy.
#
# Both values are PUBLIC by design. The publishable key is safe in browser code;
# never put a `sb_secret_*` or `service_role` key in a `VITE_*` variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
