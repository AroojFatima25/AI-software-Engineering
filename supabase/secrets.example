# ---------------------------------------------------------------------------
# agent-runner — server-side secrets template
#
# Copy the values into the Supabase Edge Function's environment. They live on
# the SERVER ONLY. Never copy any of these into the frontend, into a `.env`
# file next to the Vite app, or into a `VITE_*` variable — anything prefixed
# `VITE_` is inlined into the public JavaScript bundle at build time.
#
#   Set all of them in one command:
#
#     supabase secrets set --env-file ./secrets.example
#
#   Or individually:
#
#     supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
#     supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...
#
#   Inspect what is currently set (names only, values are masked):
#
#     supabase secrets list
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED
# ===========================================================================

# Supabase project URL.
# Injected automatically into every Edge Function by the Supabase runtime —
# listed here for local runs (`deno serve`) where nothing is injected.
# Dashboard: Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable (anon) key.
# Also injected automatically by the runtime. Used only to build the
# caller-scoped client that validates the user's JWT and proves workspace
# membership under Row Level Security.
# Dashboard: Project Settings → API → Project API keys (publishable)
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Supabase SECRET key (a.k.a. service_role).
# REQUIRED. Bypasses RLS and is the only way to write the agent-owned tables
# (run_stages, run_agent_activity, tasks, proposed_changes, changed_files,
# activity_events), which the schema deliberately denies to the browser.
# NEVER expose this in frontend code or a VITE_* variable.
# Dashboard: Project Settings → API → Project API keys (secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY

# OpenRouter API key.
# REQUIRED. The agent-runner Edge Function is the ONLY component that talks to
# OpenRouter; the browser never sees this key and never calls OpenRouter.
# Dashboard: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY


# ===========================================================================
# OPTIONAL — model selection
# ===========================================================================

# Model used for every stage.
# Default: anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter API base URL. Only override for a proxy or a compatible gateway.
# Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Max completion tokens per stage call. Default: 4000
# Raise this for the implementation stage if diffs are being truncated.
OPENROUTER_MAX_TOKENS=4000

# Sampling temperature. Default: 0.2 (low — these stages want deterministic,
# structured output, not creative prose).
OPENROUTER_TEMPERATURE=0.2

# Optional attribution headers OpenRouter records on its public leaderboard.
# Leave blank to omit them.
OPENROUTER_SITE_URL=https://your-production-domain
OPENROUTER_APP_NAME=AI Software Engineering


# ===========================================================================
# OPTIONAL — retry & timeout behaviour
# ===========================================================================

# Attempts per stage before the stage is marked failed. Default: 3
# Set to 1 to disable stage-level retries.
AGENT_RUNNER_MAX_STAGE_ATTEMPTS=3

# Wall-clock budget for a single OpenRouter call, in milliseconds.
# Default: 120000 (2 minutes)
AGENT_RUNNER_STAGE_TIMEOUT_MS=120000

# Wall-clock budget for an entire run (all 7 stages), in milliseconds.
# Default: 900000 (15 minutes).
# NOTE: Supabase Edge Functions have their own wall-clock cap. If a full run
# can exceed it, lower this value and drive long work through the `drain`
# worker on a schedule instead. See supabase/README.md.
AGENT_RUNNER_RUN_TIMEOUT_MS=900000

# Base delay for exponential backoff, in milliseconds. Default: 500
# Actual delay = base * 2^(attempt-1), capped, with full jitter.
AGENT_RUNNER_RETRY_BASE_DELAY_MS=500

# Attempts for transient Supabase/Postgres write failures. Default: 4
AGENT_RUNNER_MAX_WRITE_ATTEMPTS=4


# ===========================================================================
# OPTIONAL — run recovery
# ===========================================================================

# A run left in `running` whose `updated_at` has not moved for this many
# minutes is considered stale and is returned to the queue. Default: 15
# The pipeline heartbeats `runs.updated_at` roughly every third of this window,
# so a live run is never mistaken for a dead one.
AGENT_RUNNER_STALE_AFTER_MINUTES=15

# Total attempts allowed for one run (the original try plus recoveries).
# Default: 3. Once exhausted the run is marked `failed`, not requeued forever.
AGENT_RUNNER_MAX_RUN_ATTEMPTS=3

# Queued runs claimed per `drain` invocation. Default: 5
AGENT_RUNNER_DRAIN_BATCH_SIZE=5


# ===========================================================================
# OPTIONAL — access control
# ===========================================================================

# Comma-separated browser origins allowed to call this function (CORS).
# An empty value denies all cross-origin BROWSER calls; curl, cron and other
# non-browser callers are unaffected because they do not enforce CORS.
# Use "*" only for local development.
AGENT_RUNNER_ALLOWED_ORIGINS=https://your-production-domain,https://your-preview-domain.vercel.app

# Shared bearer token for the server-to-server actions (`drain`,
# `recover_stale`), which carry no user JWT. Send it as
# `X-Agent-Runner-Worker: <token>`.
# Generate one with:  openssl rand -hex 32
# If left EMPTY those actions are disabled outright rather than left open.
AGENT_RUNNER_WORKER_TOKEN=

# Create missing `agents` rows for the known agent keys on first use.
# Default: true. Set to false if you seed the agents table yourself — the
# runner will then fail a stage with a clear error if an agent row is missing.
AGENT_RUNNER_AUTOCREATE_AGENTS=true
